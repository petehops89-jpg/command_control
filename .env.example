# Vistamations — Environment Variables Template
# Copy this to .env and fill in your values
# .env is gitignored — NEVER commit real secrets

# Google Cloud — Vertex AI
# Project ID from Google Cloud Console
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=%APPDATA%\gcloud\application_default_credentials.json
GEMINI_CLI_TRUST_WORKSPACE=true

# Redis (default password — change in production)
# Used by docker-compose.yml for redis --requirepass and app REDIS_PASSWORD env
REDIS_PASSWORD=your-redis-password

# API keys — managed via Windows Credential Manager vault
# Do NOT put real keys here. Use:
#   node .vscode/pete/vista-localsub-root/vista-localenv-env-root/vista-sec-water/api-key-env-link/enroll.js
# The vault reads from Credential Manager → process.env → fallback
